# =============================================================================
# SocraticAI — environment configuration
# Copy this file to `.env` and fill in real values. Nothing here is secret in
# default form; the app boots with safe defaults for all values below.
# =============================================================================

# --- Application -------------------------------------------------------------
APP_NAME=SocraticAI
APP_VERSION=1.0.0
APP_ENVIRONMENT=development
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=true
# Comma-separated list of origins allowed by CORS
APP_ALLOWED_ORIGINS=http://localhost:8501,http://localhost:8000

# --- LLM ---------------------------------------------------------------------
# Provider can be "openai" or "gemini". Every agent reads this setting at
# runtime, so switching providers is a one-line config change.
# Provider can be "openai", "gemini" or "demo". "demo" runs the whole system
# offline with a deterministic tutor — no API key required (ideal for CI/try-it).
LLM_PROVIDER=openai
LLM_OPENAI_API_KEY=sk-...
LLM_OPENAI_MODEL=gpt-4o-mini
LLM_OPENAI_TEMPERATURE=0.4
LLM_GEMINI_API_KEY=AIza...
LLM_GEMINI_MODEL=gemini-1.5-flash
LLM_GEMINI_TEMPERATURE=0.4
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2

# --- Database (SQLite by default; point DATABASE_URL anywhere SQLAlchemy) ----
DATABASE_URL=sqlite:///./data/socraticai.db
DATABASE_ECHO=false
DATABASE_CREATE_ON_STARTUP=true

# --- Vector store (ChromaDB) --------------------------------------------------
VECTOR_PERSIST_DIRECTORY=./data/chroma
VECTOR_COLLECTION_NAME=socraticai_notes
VECTOR_EMBEDDING_MODEL=all-MiniLM-L6-v2
VECTOR_CHUNK_SIZE=600
VECTOR_CHUNK_OVERLAP=100
VECTOR_TOP_K=4

# --- API ----------------------------------------------------------------------
API_PREFIX=/api/v1
API_UPLOAD_DIR=./data/uploads
API_PAGINATION_DEFAULT_SIZE=20
API_MAX_UPLOAD_SIZE_BYTES=26214400 # 25 MB

# --- Authentication & Security ------------------------------------------------
AUTH_SECRET_KEY=change-this-to-a-secure-random-32-byte-secret-in-production
AUTH_ALGORITHM=HS256
AUTH_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Logging ------------------------------------------------------------------
LOGGING_LEVEL=INFO
LOGGING_JSON_FORMAT=false
LOGGING_LOG_DIR=./logs

# --- Frontend -----------------------------------------------------------------
FRONTEND_API_BASE_URL=http://localhost:8000

# --- Conversation & Working Memory --------------------------------------------
CONVERSATION_HISTORY_LIMIT=10
CONVERSATION_CONTEXT_TOKEN_BUDGET=1500
CONVERSATION_MAX_MESSAGE_LENGTH=8000
CONVERSATION_SUMMARY_TRIGGER_TURNS=6

# --- Memory (Episodic & Semantic) ---------------------------------------------
MEMORY_EPISODIC_COLLECTION_NAME=socraticai_episodic_memory
MEMORY_EPISODIC_TOP_K=4
MEMORY_MEMORY_SIMILARITY_THRESHOLD=0.55
MEMORY_MAX_MEMORY_CONTEXT_TOKENS=600
MEMORY_CONSOLIDATION_MESSAGE_TRIGGER=10
MEMORY_CONCEPT_EMA_ALPHA=0.6

# --- Routing (Jev / TypeSafe AI) ----------------------------------------------
ROUTING_JEV_ENABLED=false
ROUTING_JEV_API_KEY=
ROUTING_JEV_MODEL=jev-latest
ROUTING_JEV_TIMEOUT_SECONDS=5.0
ROUTING_JEV_RETRY_COUNT=2
ROUTING_CONFIDENCE_HIGH_THRESHOLD=0.70
ROUTING_CONFIDENCE_LOW_THRESHOLD=0.40
ROUTING_FALLBACK_STRATEGY=deterministic

# --- Caching ------------------------------------------------------------------
CACHE_ENABLED=true
CACHE_BACKEND=memory
CACHE_MAX_SIZE=10000
CACHE_DEFAULT_TTL_SECONDS=3600
CACHE_EMBEDDING_CACHE_TTL_SECONDS=86400
CACHE_RETRIEVAL_CACHE_TTL_SECONDS=1800
CACHE_RESPONSE_CACHE_ENABLED=false
CACHE_RESPONSE_CACHE_TTL_SECONDS=3600

# --- Context Assembly Budgets -------------------------------------------------
CONTEXT_TOTAL_BUDGET=4000
CONTEXT_SYSTEM_PROMPT_BUDGET=600
CONTEXT_HISTORY_BUDGET=1500
CONTEXT_EPISODIC_MEMORY_BUDGET=600
CONTEXT_SEMANTIC_PROFILE_BUDGET=400
CONTEXT_RAG_BUDGET=900
CONTEXT_TOKENIZER_ENCODING=cl100k_base
